config_version=5

[application]
config/name="Yutrel post-processing verification"
run/main_scene="res://editor_scene.tscn"

[debug]
settings/stdout/print_gpu_profile=true

[display]
window/size/viewport_width=600
window/size/viewport_height=320

[editor_plugins]
enabled=PackedStringArray("res://addons/postprocess_test/plugin.cfg")

[rendering]
renderer/rendering_method="yutrel"
